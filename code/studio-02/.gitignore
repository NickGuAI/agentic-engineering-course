# Downloaded BABILong data (setup.sh downloads this from Hugging Face). Not
# ours to redistribute; re-downloadable.
benchmarks/babilong/

# Derived from the downloaded data (setup.sh regenerates these); large and
# specific to each run's sampling, so not committed.
benchmarks/qa1_768k_survivors.json
benchmarks/subset_qa1_topend.json

# Scratch working directories for pi processes (project trust settings,
# decisions.md drafts, etc.). Not evidence; the scripts recreate what they
# need under evidence/.
work/

# Never commit environment/secret files.
*.env
.env*

# Raw --mode json event streams (evidence/part_*/raw/*.raw.jsonl). These are
# the scripts' own verbose capture of every event pi printed; pi's own
# session files under evidence/sessions/, plus the scripts' extracted
# *.json/*.csv/*.md summaries, already carry the same run record in far less
# space.
evidence/**/*.raw.jsonl

# pi session logs from runs: kept locally, never committed (redundant with
# each part's own results.json/summary.md).
evidence/sessions/

# Python cache
__pycache__/
*.pyc
